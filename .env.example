# Copy to .env for local development. Never commit .env or real private keys.
DATABASE_URL=sqlite:///./reproducibility_chain.db
JWT_SECRET=replace-with-a-long-random-development-secret
ARTIFACT_STORAGE_DIR=storage
APP_ENV=development
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Configure only with a disposable local Hardhat test account.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
